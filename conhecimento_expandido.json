    {
      "id": "andromeda",
      "nome": "Andrômeda",
      "aliases": [
        "galáxia de Andrômeda",
        "galáxia Andrômeda",
        "M31",
        "Messier 31"
      ],
      "fatos": [
        {
          "papel": "definicao",
          "texto": "Andrômeda, também chamada M31, é uma galáxia espiral próxima da Via Láctea.",
          "fonte": "andromeda"
        },
        {
          "papel": "detalhe",
          "texto": "Andrômeda fica a cerca de 2,5 milhões de anos-luz da Terra.",
          "fonte": "andromeda",
          "aspecto": "distancia"
        },
        {
          "papel": "detalhe",
          "texto": "O nome Andrômeda também identifica a constelação em cuja direção vemos essa galáxia.",
          "fonte": "andromeda"
        },
        {
          "papel": "detalhe",
          "texto": "Em um local escuro, a galáxia de Andrômeda pode ser vista sem telescópio como uma pequena mancha difusa.",
          "fonte": "andromeda"
        }
      ],
      "area": "astronomia"
    },
    {
      "id": "galaxia",
