        "buracos negros"
      ],
      "fatos": [
        {
          "papel": "definicao",
          "texto": "Um buraco negro é uma região do espaço com gravidade tão intensa que a luz não consegue escapar de dentro de seu horizonte de eventos.",
          "fonte": "buracos_negros"
        },
        {
          "papel": "detalhe",
          "texto": "O horizonte de eventos marca o limite além do qual não há retorno para a luz.",
          "fonte": "buracos_negros"
        },
        {
          "papel": "detalhe",
          "texto": "Alguns buracos negros se formam após o colapso de estrelas muito massivas.",
          "fonte": "buracos_negros"
        },
        {
          "papel": "detalhe",
          "texto": "Os efeitos sobre a matéria e a luz ao redor ajudam os cientistas a estudar buracos negros.",
          "fonte": "buracos_negros"
        }
      ],
      "area": "astronomia"
    },
