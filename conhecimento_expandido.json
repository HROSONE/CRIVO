      ],
      "fatos": [
        {
          "papel": "definicao",
          "texto": "Uma galáxia reúne estrelas, gás, poeira e outros componentes ligados pela gravidade.",
          "fonte": "galaxias"
        },
        {
          "papel": "detalhe",
          "texto": "Existem galáxias espirais, elípticas e irregulares.",
          "fonte": "galaxias"
        },
        {
          "papel": "detalhe",
          "texto": "A Via Láctea é a galáxia que abriga o Sistema Solar.",
          "fonte": "galaxias"
        },
        {
          "papel": "detalhe",
          "texto": "Galáxias podem fazer parte de grupos e aglomerados maiores.",
          "fonte": "galaxias"
        }
      ],
      "area": "astronomia"
    },
    {
      "id": "estrela",
