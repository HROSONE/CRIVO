      "aliases": [
        "estrelas"
      ],
      "fatos": [
        {
          "papel": "definicao",
          "texto": "Uma estrela é um astro formado principalmente por gás muito quente, que emite luz.",
          "fonte": "estrelas"
        },
        {
          "papel": "detalhe",
          "texto": "Na fase principal de sua vida, uma estrela produz energia pela fusão de hidrogênio em hélio em seu interior.",
          "fonte": "estrelas"
        },
        {
          "papel": "detalhe",
          "texto": "O Sol é uma estrela.",
          "fonte": "estrelas"
        },
        {
          "papel": "detalhe",
          "texto": "A massa de uma estrela influencia sua evolução e o tempo que ela permanece brilhando.",
          "fonte": "estrelas"
        }
      ],
      "area": "astronomia"
    },
    {
      "id": "nebulosa",
      "nome": "nebulosa",
      "aliases": [
        "nebulosas"
      ],
      "fatos": [
        {
          "papel": "definicao",
          "texto": "Uma nebulosa é uma nuvem de gás e poeira no espaço.",
          "fonte": "nebulosas"
        },
        {
          "papel": "detalhe",
          "texto": "Algumas nebulosas são regiões onde novas estrelas se formam.",
          "fonte": "nebulosas"
        },
        {
          "papel": "detalhe",
          "texto": "Outras nebulosas contêm material expelido por estrelas em fases finais de sua evolução.",
          "fonte": "nebulosas"
        },
        {
          "papel": "detalhe",
          "texto": "Por isso, nem toda nebulosa tem a mesma origem.",
          "fonte": "nebulosas"
        }
      ],
      "area": "astronomia"
    },
    {
