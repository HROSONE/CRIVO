  "itens": [
    {
      "id": "mundo_cerebro",
      "nome": "cérebro",
      "area": "neurociencia",
      "aliases": [
        "cérebro humano"
      ],
      "fatos": [
        {
          "texto": "O cérebro é um órgão do sistema nervoso que participa do pensamento, da memória e do controle do corpo.",
          "fonte": "wol_cerebro",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Ele integra informações dos sentidos e coordena respostas do organismo.",
          "fonte": "wol_cerebro",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcao"
        },
        {
          "texto": "O córtex cerebral forma a camada externa do cérebro e apresenta dobras.",
          "fonte": "wol_cerebro",
          "papel": "detalhe",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_neuronio",
      "nome": "neurônio",
      "area": "neurociencia",
      "aliases": [
        "neurônios",
        "célula nervosa",
        "células nervosas"
      ],
      "fatos": [
        {
          "texto": "Um neurônio é uma célula nervosa especializada em receber e transmitir sinais.",
          "fonte": "wol_cerebro",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Dendritos recebem muitos sinais; o axônio conduz sinais para outras células.",
          "fonte": "wol_cerebro",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcionamento"
        },
        {
          "texto": "Neurônios se comunicam através de sinapses, pontos de transmissão entre células.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcao"
        },
        {
          "texto": "O neurônio é uma célula; a sinapse é uma conexão de comunicação entre células.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_sinapse",
      "nome": "sinapse",
      "area": "neurociencia",
      "aliases": [
        "sinapses"
      ],
      "fatos": [
        {
          "texto": "Uma sinapse é um ponto de comunicação entre um neurônio e outra célula.",
          "fonte": "wol_cerebro_funciona",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Nas sinapses químicas, neurotransmissores levam o sinal entre as células.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcionamento"
        }
      ]
    },
    {
      "id": "mundo_neurotransmissor",
      "nome": "neurotransmissor",
      "area": "neurociencia",
      "aliases": [
        "neurotransmissores"
      ],
      "fatos": [
        {
          "texto": "Um neurotransmissor é uma substância que transmite sinais em sinapses químicas.",
          "fonte": "wol_cerebro_funciona",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "A célula libera essa substância; sua ligação a receptores influencia a célula receptora.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcionamento"
        }
      ]
    },
    {
      "id": "mundo_cortex",
      "nome": "córtex cerebral",
      "area": "neurociencia",
      "aliases": [
        "córtex"
      ],
      "fatos": [
        {
          "texto": "O córtex cerebral é a camada externa do cérebro, envolvida em percepção, movimento e pensamento.",
          "fonte": "wol_cerebro",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Suas dobras ampliam a superfície disponível dentro do crânio.",
          "fonte": "wol_cerebro",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcionamento"
        }
      ]
    },
    {
      "id": "mundo_hipocampo",
      "nome": "hipocampo",
      "area": "neurociencia",
      "aliases": [],
      "fatos": [
        {
          "texto": "O hipocampo é uma estrutura cerebral envolvida na formação de novas memórias declarativas.",
          "fonte": "wol_cerebro_funciona",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Ele participa da consolidação da memória, ajudando a estabilizar novas informações.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcao"
        }
      ]
    },
    {
      "id": "mundo_memoria",
      "nome": "memória",
      "area": "neurociencia",
      "aliases": [
        "memória humana"
      ],
      "fatos": [
        {
          "texto": "A memória é a capacidade de registrar, conservar e recuperar informações e experiências.",
          "fonte": "wol_memoria",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Atenção, associação, organização e revisão ajudam a aprender e recordar informações.",
          "fonte": "wol_memoria",
          "papel": "detalhe",
          "natureza": "orientacao",
          "aspecto": "funcionamento"
        },
        {
          "texto": "Associar um nome a uma imagem conhecida é uma estratégia para recordá-lo.",
          "fonte": "wol_memoria",
          "papel": "exemplo",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_memoria_declarativa",
      "nome": "memória declarativa",
      "area": "neurociencia",
      "aliases": [
        "memória explícita"
      ],
      "fatos": [
        {
          "texto": "A memória declarativa permite recordar conscientemente fatos e acontecimentos.",
          "fonte": "wol_cerebro_funciona",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Lembrar o nome de uma pessoa é um exemplo de memória declarativa.",
          "fonte": "wol_cerebro_funciona",
          "papel": "exemplo",
          "natureza": "cientifico"
        },
        {
          "texto": "A memória declarativa envolve fatos e acontecimentos; a procedural envolve habilidades aprendidas.",
          "fonte": "wol_cerebro_funciona",
          "papel": "detalhe",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_memoria_procedural",
      "nome": "memória procedural",
      "area": "neurociencia",
      "aliases": [
        "memória processual",
        "memória de procedimentos"
      ],
      "fatos": [
        {
          "texto": "A memória procedural conserva habilidades aprendidas por prática.",
          "fonte": "wol_cerebro_funciona",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Andar de bicicleta é um exemplo de habilidade apoiada na memória procedural.",
          "fonte": "wol_cerebro_funciona",
          "papel": "exemplo",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_neuroplasticidade",
      "nome": "neuroplasticidade",
      "area": "neurociencia",
      "aliases": [
        "plasticidade cerebral",
        "plasticidade neural"
      ],
      "fatos": [
        {
          "texto": "Neuroplasticidade é a capacidade de o cérebro modificar conexões em resposta a experiências e aprendizagem.",
          "fonte": "wol_cerebro_uso",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "Praticar uma habilidade estimula mudanças nos circuitos envolvidos nessa atividade.",
          "fonte": "wol_cerebro_uso",
          "papel": "detalhe",
          "natureza": "cientifico",
          "aspecto": "funcionamento"
        },
        {
          "texto": "Essa capacidade não significa memória ilimitada nem aprendizagem instantânea.",
          "fonte": "wol_cerebro_uso",
          "papel": "limite",
          "natureza": "cientifico"
        }
      ]
    },
    {
      "id": "mundo_mnemonica",
      "nome": "mnemônica",
      "area": "aprendizagem",
      "aliases": [
        "mnemônicas",
        "técnica mnemônica",
        "técnicas mnemônicas",
        "método de loci"
      ],
      "fatos": [
        {
          "texto": "Uma mnemônica é uma estratégia de associação que ajuda a recordar informações.",
          "fonte": "wol_memoria",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "No método de loci, a pessoa associa informações a lugares de um percurso conhecido.",
          "fonte": "wol_memoria",
          "papel": "exemplo",
          "natureza": "cientifico"
        },
        {
          "texto": "A estratégia auxilia a recordação, mas não substitui compreensão e revisão.",
          "fonte": "wol_memoria",
          "papel": "limite",
          "natureza": "orientacao"
        }
      ]
    },
    {
      "id": "mundo_sono",
      "nome": "sono",
      "area": "saude",
      "aliases": [
        "dormir"
      ],
      "fatos": [
        {
          "texto": "O sono é um estado fisiológico recorrente com mudanças na consciência e na atividade do organismo.",
          "fonte": "wol_sono",
          "papel": "definicao",
          "natureza": "cientifico"
        },
        {
          "texto": "O sono ajuda a memória ao favorecer a consolidação de informações aprendidas.",
          "fonte": "nhlbi_sono",
          "papel": "causa",
          "natureza": "cientifico",
          "aspecto": "funcao",
          "fontes": [
            "wol_sono"
          ]
        },
        {
          "texto": "Uma noite de sono alterna fases não REM e REM em ciclos.",
