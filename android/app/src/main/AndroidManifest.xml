<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Só para o servidor local em 127.0.0.1 (o Android exige esta permissão até para sockets locais).
         O CRIVO não acessa a internet: tudo roda no aparelho. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_crivo"
        android:roundIcon="@mipmap/ic_crivo"
        android:label="CRIVO"
        android:networkSecurityConfig="@xml/rede_local"
        android:theme="@style/Tema.Crivo">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
