<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para o servidor local em 127.0.0.1 (o Android exige esta permissão até para sockets locais) e para a
         atualização automática (versao.json e CRIVO.apk do release android-latest no GitHub). A conversa roda no
         aparelho; o app não envia nada para fora. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dados móveis ou Wi-Fi: o aviso de atualização diz quando o download vai usar dados móveis. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Entregar a atualização ao instalador do Android, que sempre pede a confirmação da pessoa. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_crivo"
        android:roundIcon="@mipmap/ic_crivo"
        android:label="CRIVO"
        android:networkSecurityConfig="@xml/rede_local"
        android:theme="@style/Tema.Crivo">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".InstalacaoRecebedor"
            android:exported="false" />
    </application>
</manifest>
